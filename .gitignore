# Stray artifact of an older manually launched bridge. The
# single-instance lock is NOT written here any more -- it lives in
# LLMChatter.RuntimeDir, because the documented Docker setup mounts
# the tools directory read-only. Kept ignored so an old file left
# over from a previous version never gets committed; bridge.out
# is the conventional stdout redirect target when running it with nohup.
tools/bridge.out
tools/bridge.pid
